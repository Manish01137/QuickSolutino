# Contact form email (https://resend.com). Set these in Vercel: Settings > Environment Variables.
# One key per form (separate Resend accounts), or a single shared RESEND_API_KEY.
RESEND_API_KEY_CUSTOMER=
RESEND_API_KEY_PARTNER=
# Optional. Defaults to onboarding@resend.dev, which only delivers to each Resend account's own email.
# After verifying a domain in Resend, set e.g. Quick Solutions Website <website@mail.quick-solutions.in>
CONTACT_FROM_EMAIL=
